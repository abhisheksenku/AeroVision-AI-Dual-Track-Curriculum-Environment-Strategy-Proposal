# AeroVision AI - Comprehensive Git Ignore

# Python & Virtual Environments
.venv/
.venv_tf/
.venv*/
**/.venv*/
venv/
env/
ENV/
*.pyc
__pycache__/
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
eggs/
.eggs/

# Datasets and Media Storage
data/samples/*
!data/samples/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/reference_docs/*
!data/reference_docs/.gitkeep

# Model Weights & Exported Artifacts
models/weights/*
!models/weights/.gitkeep
models/checkpoints/*
!models/checkpoints/.gitkeep
models/export/*
!models/export/.gitkeep
*.pt
*.onnx
*.engine
*.tflite
*.keras
*.h5

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Node & Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database & Vector DB
*.db
*.sqlite3
qdrant_storage/
data/qdrant/
data/qdrant_db/
data/qdrant_test/
scratch/

# IDE & OS Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
