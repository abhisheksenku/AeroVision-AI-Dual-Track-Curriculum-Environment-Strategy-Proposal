# AeroVision AI - Comprehensive Git Ignore

# Python & Virtual Environments
.venv/
venv/
env/
ENV/
*.pyc
__pycache__/
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
eggs/
.eggs/

# Datasets and Media Storage
data/samples/*
!data/samples/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/reference_docs/*
!data/reference_docs/.gitkeep

# Model Weights
models/weights/*
!models/weights/.gitkeep
*.pt
*.onnx
*.engine

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Node & Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database & Vector DB
*.db
*.sqlite3
qdrant_storage/

# IDE & OS Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
