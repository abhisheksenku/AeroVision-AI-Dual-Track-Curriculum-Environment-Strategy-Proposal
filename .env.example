# AeroVision AI - Environment Configuration Template
# Copy this file to .env and populate your actual values.
# NEVER commit .env to version control.

# Application Configuration
APP_NAME=AeroVision AI
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Hardware & Computer Vision Inference
# Options: cpu, cuda (if NVIDIA GPU available), openvino
CV_DEVICE=cpu
CV_MODEL_NAME=yolo11n.pt
CV_MODEL_DIR=./models/weights
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
TRACKER_TYPE=bytetrack

# Storage Paths
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
SAMPLES_DIR=./data/samples
REFERENCE_DOCS_DIR=./data/reference_docs

# Database Configuration (Defaults to SQLite for local development; supports PostgreSQL)
# Example PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/aerovision_db
DATABASE_URL=sqlite+aiosqlite:///./aerovision.db

# Qdrant Vector DB Configuration
QDRANT_MODE=memory # Options: memory, local, remote
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=drone_knowledge_base

# Google Gemini API (Required for Phase 6 AI Agent)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Frontend URL (For CORS configuration)
FRONTEND_URL=http://localhost:5173
